<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RemoteStuff.ViewModels"
             xmlns:controls="using:RemoteStuff.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RemoteStuff.Views.MqttTabView"
             x:DataType="vm:MqttTabViewModel">

    <UserControl.Styles>
        <!-- Section header: title button (toggles collapse) + maximize button. -->
        <Style Selector="Button.paneHdr">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="Button.paneHdr:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.paneIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="240,4,*">

        <!-- Topic tree -->
        <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="{DynamicResource AppChromeBrush}"
                        BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                    <TextBlock Text="Topics" Foreground="{DynamicResource AppSecondaryTextBrush}" FontWeight="SemiBold" />
                </Border>
                <TreeView Grid.Row="1" ItemsSource="{Binding TopicTree}"
                          SelectedItem="{Binding SelectedTopic, Mode=TwoWay}"
                          Background="Transparent">
                    <TreeView.ContextMenu>
                        <ContextMenu x:DataType="vm:MqttTabViewModel">
                            <MenuItem Header="Expand All" Command="{Binding ExpandAllTopicsCommand}" />
                            <MenuItem Header="Collapse All" Command="{Binding CollapseAllTopicsCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:MqttTopicNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:MqttTopicNode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource AppMutedTextBrush}"
                                           FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LatestPayload}" Foreground="#7FB0DE"
                                           FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="110" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Background="{DynamicResource AppDividerBrush}" ResizeDirection="Columns" />

        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Subscribe -->
        <Border Grid.Row="0" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Subscribe" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBox Text="{Binding SubscribeTopic}" Width="240" Watermark="topic/# " />
                <Button Content="Subscribe" Command="{Binding SubscribeCommand}" />
                <Button Content="Reconnect" Command="{Binding ReconnectCommand}" />
                <Button Content="Clear" Command="{Binding ClearMessagesCommand}" />
            </StackPanel>
        </Border>

        <!-- Publish -->
        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Publish" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                <TextBox Text="{Binding PublishTopic}" Width="200" Watermark="topic" />
                <TextBox Text="{Binding PublishPayload}" Width="300" Watermark="payload" />
                <Button Content="Publish" Command="{Binding PublishCommand}" />
            </StackPanel>
        </Border>

        <!-- Stacked sections: each can be collapsed to its header or maximized to fill
             the whole area (the maximize button toggles; the title toggles collapse). -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding GraphRowHeight}" />
                <RowDefinition Height="{Binding PayloadRowHeight}" />
                <RowDefinition Height="{Binding HistoryRowHeight}" />
            </Grid.RowDefinitions>

            <!-- Graph -->
            <Border Grid.Row="0" Background="{DynamicResource AppInsetBrush}"
                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding HasSelectedTopic}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppChromeBrush}"
                            BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="paneIcon" Command="{Binding MaximizeGraphCommand}"
                                    ToolTip.Tip="Expand this section / restore">
                                <controls:LineIcon Kind="{Binding GraphMaxIcon}" Width="14" Height="14" />
                            </Button>
                            <Button Classes="paneHdr" Command="{Binding ToggleGraphCollapsedCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:LineIcon Kind="{Binding GraphCollapseIcon}" Width="14" Height="14" />
                                    <TextBlock Text="Graph" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <Border IsVisible="{Binding GraphContentVisible}">
                        <controls:NumericSeriesGraphView DataContext="{Binding Graph}" Margin="4" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- Payload (JSON) -->
            <Border Grid.Row="1" Background="{DynamicResource AppInsetBrush}"
                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding HasSelectedTopic}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppChromeBrush}"
                            BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="paneIcon" Command="{Binding MaximizePayloadCommand}"
                                    ToolTip.Tip="Expand this section / restore">
                                <controls:LineIcon Kind="{Binding PayloadMaxIcon}" Width="14" Height="14" />
                            </Button>
                            <Button Classes="paneHdr" Command="{Binding TogglePayloadCollapsedCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:LineIcon Kind="{Binding PayloadCollapseIcon}" Width="14" Height="14" />
                                    <TextBlock Text="Payload (JSON)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <ScrollViewer IsVisible="{Binding PayloadContentVisible}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding SelectedPayloadPretty}"
                                             Margin="4"
                                             FontFamily="Menlo, Consolas, monospace" FontSize="12"
                                             Foreground="{DynamicResource AppTextBrush}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- History (messages) -->
            <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AppChromeBrush}"
                            BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="paneIcon" Command="{Binding MaximizeHistoryCommand}"
                                    ToolTip.Tip="Expand this section / restore">
                                <controls:LineIcon Kind="{Binding HistoryMaxIcon}" Width="14" Height="14" />
                            </Button>
                            <Button Classes="paneHdr" Command="{Binding ToggleHistoryCollapsedCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:LineIcon Kind="{Binding HistoryCollapseIcon}" Width="14" Height="14" />
                                    <TextBlock Text="History" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <ListBox IsVisible="{Binding HistoryContentVisible}" ItemsSource="{Binding Messages}" Background="{DynamicResource AppSurfaceBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MqttMessage">
                                <Grid ColumnDefinitions="70,240,*">
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource AppMutedTextBrush}" FontFamily="Menlo, Consolas, monospace" />
                                    <TextBlock Grid.Column="1" Text="{Binding Topic}" Foreground="#7FB0DE" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Payload}" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding StatusText}" Foreground="#9FD3A0" />
        </Border>
        </Grid>
    </Grid>
</UserControl>

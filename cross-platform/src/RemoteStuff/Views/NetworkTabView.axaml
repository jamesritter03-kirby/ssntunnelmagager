<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RemoteStuff.ViewModels"
             mc:Ignorable="d"
             x:Class="RemoteStuff.Views.NetworkTabView"
             x:DataType="vm:NetworkTabViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <!-- Bare text button used for click-to-copy IP / MAC addresses. -->
        <Style Selector="Button.copy">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ToolTip.Tip" Value="Click to copy" />
        </Style>
        <Style Selector="Button.copy:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
    </UserControl.Styles>

    <TabControl>
      <TabItem Header="Network">
        <Grid ColumnDefinitions="*,*">

        <!-- Left: this machine -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,1,0">
            <Border Grid.Row="0" Background="{DynamicResource AppChromeBrush}" Padding="10,8" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="This machine" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                                 IsVisible="{Binding IsRefreshing}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Padding="10,8" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Host:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                        <TextBlock Text="{Binding HostName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Gateway:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                        <Button Classes="copy" Command="{Binding CopyTextCommand}" CommandParameter="{Binding DefaultGateway}">
                            <TextBlock Text="{Binding DefaultGateway}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="DNS:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                        <Button Classes="copy" Command="{Binding CopyTextCommand}" CommandParameter="{Binding DnsServers}">
                            <TextBlock Text="{Binding DnsServers}" TextWrapping="Wrap" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Public IP:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                        <Button Classes="copy" Command="{Binding CopyTextCommand}" CommandParameter="{Binding PublicIp}">
                            <TextBlock Text="{Binding PublicIp}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="3" IsVisible="{Binding HasWifi}">
                        <Separator Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Wi-Fi:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                            <TextBlock Text="{Binding WifiSsid}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Signal:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                            <TextBlock Text="{Binding WifiSignal}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Channel:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                            <TextBlock Text="{Binding WifiChannel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Tx Rate:" Foreground="{DynamicResource AppMutedTextBrush}" Width="90" />
                            <TextBlock Text="{Binding WifiTxRate}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="2" ItemsSource="{Binding Interfaces}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkTabViewModel+InterfaceRow">
                        <StackPanel Spacing="1" Margin="2">
                            <Button Classes="copy" ToolTip.Tip="Click to scan this network"
                                    Command="{Binding $parent[ListBox].((vm:NetworkTabViewModel)DataContext).UseInterfaceForScanCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding StatusGlyph}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource AppMutedTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="copy" Margin="18,0,0,0"
                                    Command="{Binding $parent[ListBox].((vm:NetworkTabViewModel)DataContext).CopyTextCommand}"
                                    CommandParameter="{Binding Ipv4}"
                                    IsVisible="{Binding Ipv4, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Ipv4}" Foreground="#bbb" FontSize="11" />
                            </Button>
                            <Button Classes="copy" Margin="18,0,0,0"
                                    Command="{Binding $parent[ListBox].((vm:NetworkTabViewModel)DataContext).CopyTextCommand}"
                                    CommandParameter="{Binding Ipv6}"
                                    IsVisible="{Binding Ipv6, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Ipv6}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" />
                            </Button>
                            <Button Classes="copy" Margin="18,0,0,0"
                                    Command="{Binding $parent[ListBox].((vm:NetworkTabViewModel)DataContext).CopyTextCommand}"
                                    CommandParameter="{Binding Mac}"
                                    IsVisible="{Binding Mac, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Mac}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right: LAN scanner -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Background="{DynamicResource AppChromeBrush}" Padding="10,8" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="LAN scanner (ping sweep /24)" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Padding="10,8" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Subnet:" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ScanSubnet}" Watermark="192.168.1" Width="140" />
                    <TextBlock Text=".0/24" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" />
                    <Button Content="{Binding ScanButtonText}"
                            Command="{Binding ScanCommand}" />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="2" ItemsSource="{Binding ScanResults}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkTabViewModel+ScanHit">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
                            <TextBlock Text="🟢" />
                            <Button Classes="copy"
                                    Command="{Binding $parent[ListBox].((vm:NetworkTabViewModel)DataContext).CopyTextCommand}"
                                    CommandParameter="{Binding Ip}">
                                <TextBlock Text="{Binding Display}" />
                            </Button>
                            <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0} ms'}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" Padding="10,4" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0">
                <StackPanel Spacing="3">
                    <ProgressBar Value="{Binding ScanProgress}" Maximum="100" Height="4"
                                 IsVisible="{Binding IsScanning}" />
                    <TextBlock Text="{Binding ScanStatus}" Foreground="#999" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
      </TabItem>

      <!-- Router & DNS: privileged, per-OS network configuration -->
      <TabItem Header="Router &amp; DNS">
        <ScrollViewer>
          <StackPanel Margin="14" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

            <!-- Unsupported platform notice -->
            <Border Background="{DynamicResource AppSurfaceBrush}" Padding="12" CornerRadius="6"
                    IsVisible="{Binding !AdminSupported}">
              <TextBlock Text="Privileged network configuration is not available on this platform."
                         TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" />
            </Border>

            <StackPanel Spacing="16" IsVisible="{Binding AdminSupported}">

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Adapter" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Refresh adapters" Command="{Binding RefreshAdaptersCommand}"
                        IsEnabled="{Binding !IsAdminBusy}" />
                <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                             IsVisible="{Binding IsAdminBusy}" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Unified network configuration card -->
              <Border Background="{DynamicResource AppSurfaceBrush}" Padding="12" CornerRadius="6">
                <StackPanel Spacing="10">

                  <!-- DNS & gateway -->
                  <TextBlock Text="DNS &amp; gateway" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Adapter:" Width="100" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding DnsAdapter}"
                              MinWidth="240" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="DNS:" Width="100" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <TextBox Text="{Binding DnsEditText}" Watermark="1.1.1.1, 8.8.8.8 (blank = auto)" Width="240" />
                    <Button Content="Apply" Classes="accent" Command="{Binding ApplyDnsCommand}"
                            IsEnabled="{Binding !IsAdminBusy}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Gateway:" Width="100" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <TextBox Text="{Binding GatewayEditText}" Watermark="192.168.1.1" Width="240" />
                    <Button Content="Apply" Classes="accent" Command="{Binding ApplyGatewayCommand}"
                            IsEnabled="{Binding !IsAdminBusy}" />
                  </StackPanel>

                  <Separator Margin="0,4" />

                  <!-- This computer as a router -->
                  <TextBlock Text="This computer as a router" FontWeight="SemiBold" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                             Text="Share internet from an upstream adapter with devices on a downstream adapter using NAT. The downstream adapter is assigned the router IP automatically." />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Upstream:" Width="100" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding UpstreamAdapter}"
                              MinWidth="240" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Downstream:" Width="100" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding DownstreamAdapter}"
                              MinWidth="240" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Router IP:" Width="100" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <TextBox Text="{Binding RouterIp, Mode=TwoWay}" Width="130" Watermark="10.1.1.1" />
                    <TextBlock Text="Subnet:" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <TextBox Text="{Binding RouterSubnet, Mode=TwoWay}" Width="130" Watermark="255.255.255.0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="DHCP range:" Width="100" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <TextBox Text="{Binding DhcpStart, Mode=TwoWay}" Width="125" Watermark="10.1.1.100" />
                    <TextBlock Text="—" VerticalAlignment="Center" />
                    <TextBox Text="{Binding DhcpEnd, Mode=TwoWay}" Width="125" Watermark="10.1.1.254" />
                  </StackPanel>
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}"
                             Text="DHCP range is informational — use the DNS &amp; gateway fields above to set the upstream adapter's DNS, or assign client IPs manually within this range." />
                  <CheckBox Content="Start this router automatically when the app launches"
                            IsChecked="{Binding AutoStartRouter, Mode=TwoWay}" />
                  <Button Content="{Binding ShareButtonText}" Classes="accent"
                          Command="{Binding ToggleSharingCommand}" IsEnabled="{Binding !IsAdminBusy}" />

                </StackPanel>
              </Border>

              <!-- Status + warnings -->
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding AdminStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AdminHint}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                           Text="These operations change system networking and require administrator rights. They can disrupt your connection — use with care." />
              </StackPanel>

            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
</UserControl>

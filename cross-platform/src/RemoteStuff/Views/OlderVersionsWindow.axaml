<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteStuff.ViewModels"
        x:Class="RemoteStuff.Views.OlderVersionsWindow"
        x:DataType="vm:OlderVersionsViewModel"
        Width="560" Height="520"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBrush}"
        Title="Install an Older Version">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBlock Text="Install an Older Version" FontWeight="SemiBold" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                           Text="Remote Stuff normally keeps itself up to date automatically. To go back to an earlier build, pick it below — it installs in place and the app restarts." />
                <TextBlock FontSize="12" Opacity="0.6"
                           Text="{Binding CurrentVersion, StringFormat='You’re running {0}.'}" />
            </StackPanel>
        </Border>

        <!-- Footer actions -->
        <Border DockPanel.Dock="Bottom" Padding="12,8"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="All Releases on GitHub"
                        Command="{Binding OpenReleasesPageCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            IsVisible="{Binding IsInstalled}" />
                    <Button Content="Check for the Latest Version…" Classes="accent"
                            Command="{Binding CheckLatestCommand}" IsVisible="{Binding IsInstalled}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: version list / empty state -->
        <Panel Margin="12">
            <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                       TextAlignment="Center" IsVisible="{Binding !HasVersions}" />
            <ScrollViewer IsVisible="{Binding HasVersions}">
                <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="10"
                                    Background="{DynamicResource AppChromeBrush}"
                                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Text="{Binding}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <Button Grid.Column="1" Content="Install"
                                            x:CompileBindings="False"
                                            Command="{Binding $parent[ItemsControl].DataContext.InstallVersionCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteStuff.ViewModels"
        xmlns:controls="using:RemoteStuff.Views.Controls"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="RemoteStuff.Views.ProfileComparisonWindow"
        x:DataType="vm:ProfileComparisonViewModel"
        Width="980" Height="640"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBrush}"
        Title="Compare &amp; Bulk Edit Profiles">

    <Window.Resources>
        <!-- A slim drag handle on a column's trailing edge; dragging it resizes
             and persists the column width. -->
        <ControlTheme x:Key="ColumnResizeThumb" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Rectangle Width="1" HorizontalAlignment="Center"
                                   Fill="{DynamicResource AppDividerBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon Kind="table" Width="16" Height="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Text="Compare &amp; Bulk Edit Profiles" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Tick profiles, choose a setting and a value, then apply it to the whole selection."
                               FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Reset widths" VerticalAlignment="Center"
                        IsVisible="{Binding HasCustomColumnWidths}"
                        Command="{Binding ResetColumnWidthsCommand}"
                        ToolTip.Tip="Restore every column to its default width" />
            </Grid>
        </Border>

        <!-- Bulk-edit panel -->
        <Border DockPanel.Dock="Bottom" Padding="14,10"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Select all" Command="{Binding SelectAllCommand}" />
                    <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
                    <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Setting" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    <ComboBox MinWidth="160" ItemsSource="{Binding EditableFields}"
                              SelectedItem="{Binding SelectedField}" />

                    <TextBlock Text="Value" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    <TextBox MinWidth="180" IsVisible="{Binding FieldIsText}"
                             Text="{Binding TextValue}" Watermark="new value" />
                    <ComboBox MinWidth="180" IsVisible="{Binding FieldIsOptions}"
                              ItemsSource="{Binding CurrentOptions}"
                              SelectedItem="{Binding OptionValue}" />

                    <Button Content="Copy from selected" Command="{Binding UseFirstSelectedValueCommand}"
                            ToolTip.Tip="Fill the value box from the first ticked profile" />
                    <Button Content="Apply to selected" Classes="accent"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource AppDividerBrush}" Margin="0,2" />

                <!-- Unify passwords: store one password on every ticked remote profile at once. -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Password" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    <TextBox MinWidth="180" PasswordChar="•" Text="{Binding PasswordValue}"
                             Watermark="shared password" />
                    <Button Content="Set on selected" Classes="accent"
                            Command="{Binding ApplyPasswordCommand}" IsEnabled="{Binding CanSetPassword}"
                            ToolTip.Tip="Store this password (encrypted) on every ticked remote profile" />
                    <Button Content="Clear on selected" Command="{Binding ClearPasswordsCommand}"
                            ToolTip.Tip="Remove the saved password from every ticked profile" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource AppDividerBrush}" Margin="0,2" />

                <!-- Copy list-valued settings between profiles. -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Lists" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    <Button Content="Copy Lists Between Profiles…" Command="{Binding CopyListsCommand}"
                            ToolTip.Tip="Preview a profile's saved commands, links, port forwards or environment variables and copy them onto the ticked profiles" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Comparison table. The outer ScrollViewer scrolls horizontally (moving the
             pinned header and the rows together); the inner one scrolls the rows
             vertically under the frozen header. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <DockPanel>

                <!-- Pinned header row -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource AppInsetBrush}"
                        BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" />
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComparisonColumn">
                                    <Grid Width="{Binding Width}">
                                        <TextBlock Text="{Binding Header}" Padding="8,6"
                                                   FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <primitives:Thumb Theme="{StaticResource ColumnResizeThumb}"
                                                          DragDelta="OnColumnDragDelta"
                                                          DragCompleted="OnColumnDragCompleted" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileCompareRow">
                                <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Width="30" Margin="8,0,0,0"
                                                  IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Width="{Binding ProfileColumn.Width}"
                                                    Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Padding="0,6" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Host}" Width="{Binding HostColumn.Width}"
                                                   Padding="8,6" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CompareCell">
                                                    <TextBlock Text="{Binding Value}" Width="{Binding Column.Width}"
                                                               Padding="8,6" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource AppTextBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

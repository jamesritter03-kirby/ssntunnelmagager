<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RemoteStuff.ViewModels"
             xmlns:controls="using:RemoteStuff.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RemoteStuff.Views.RedisTabView"
             x:DataType="vm:RedisTabViewModel">

    <UserControl.Styles>
        <!-- Section header: title button (toggles collapse) + maximize button. -->
        <Style Selector="Button.paneHdr">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="Button.paneHdr:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.paneIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <Border Grid.Row="0" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox Text="{Binding KeyFilter}" Width="220" Watermark="key pattern (*)" />
                <Button Content="Scan" Command="{Binding RefreshKeysCommand}" />
                <Button Content="Reconnect" Command="{Binding ReconnectCommand}" />
                <Button Content="Clear" Command="{Binding ClearHistoryCommand}"
                        ToolTip.Tip="Clear the value history" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            <!-- Keys -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Keys}"
                     SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                     Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,1,0"
                     FontFamily="Menlo, Consolas, monospace" />

            <!-- Value -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource AppSurfaceBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding SelectedKey}" Foreground="#7FB0DE" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KeyType}" Foreground="{DynamicResource AppMutedTextBrush}" />
                        <TextBlock Text="{Binding KeyTtl}" Foreground="#C8A05A" />
                        <Button Content="Format JSON" Command="{Binding FormatJsonCommand}" />
                        <Button Content="Save" Command="{Binding SaveValueCommand}" />
                        <Button Content="Delete" Command="{Binding DeleteKeyCommand}" />
                        <CheckBox Content="Live" IsChecked="{Binding LiveRefresh, Mode=TwoWay}"
                                  ToolTip.Tip="Auto-refresh this key every 2 seconds" />
                    </StackPanel>
                </Border>

                <!-- Stacked sections (order mirrors the MQTT tab: Graph, Value, History).
                     Each can be collapsed to its header or maximized to fill the area. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding GraphRowHeight}" />
                        <RowDefinition Height="{Binding ValueRowHeight}" />
                        <RowDefinition Height="{Binding HistoryRowHeight}" />
                    </Grid.RowDefinitions>

                    <!-- Graph -->
                    <Border Grid.Row="0" Background="{DynamicResource AppInsetBrush}"
                            BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1"
                            IsVisible="{Binding Graph.HasData}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource AppChromeBrush}"
                                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="paneIcon" Command="{Binding MaximizeGraphCommand}"
                                            ToolTip.Tip="Expand this section / restore">
                                        <controls:LineIcon Kind="{Binding GraphMaxIcon}" Width="14" Height="14" />
                                    </Button>
                                    <Button Classes="paneHdr" Command="{Binding ToggleGraphCollapsedCommand}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LineIcon Kind="{Binding GraphCollapseIcon}" Width="14" Height="14" />
                                            <TextBlock Text="Graph" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </Border>
                            <Border IsVisible="{Binding GraphContentVisible}">
                                <controls:NumericSeriesGraphView DataContext="{Binding Graph}" Margin="4" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Value editor -->
                    <Border Grid.Row="1" Background="{DynamicResource AppInsetBrush}"
                            BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource AppChromeBrush}"
                                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="paneIcon" Command="{Binding MaximizeValueCommand}"
                                            ToolTip.Tip="Expand this section / restore">
                                        <controls:LineIcon Kind="{Binding ValueMaxIcon}" Width="14" Height="14" />
                                    </Button>
                                    <Button Classes="paneHdr" Command="{Binding ToggleValueCollapsedCommand}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LineIcon Kind="{Binding ValueCollapseIcon}" Width="14" Height="14" />
                                            <TextBlock Text="Value" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </Border>
                            <TextBox IsVisible="{Binding ValueContentVisible}"
                                     Text="{Binding SelectedValue}" AcceptsReturn="True"
                                     FontFamily="Menlo, Consolas, monospace"
                                     TextWrapping="NoWrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>

                    <!-- History -->
                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource AppChromeBrush}"
                                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="paneIcon" Command="{Binding MaximizeHistoryCommand}"
                                            ToolTip.Tip="Expand this section / restore">
                                        <controls:LineIcon Kind="{Binding HistoryMaxIcon}" Width="14" Height="14" />
                                    </Button>
                                    <Button Classes="paneHdr" Command="{Binding ToggleHistoryCollapsedCommand}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LineIcon Kind="{Binding HistoryCollapseIcon}" Width="14" Height="14" />
                                            <TextBlock Text="History" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </Border>
                            <ListBox IsVisible="{Binding HistoryContentVisible}" ItemsSource="{Binding History}"
                                     Background="{DynamicResource AppSurfaceBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RedisValueSample">
                                        <Grid ColumnDefinitions="70,200,*">
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource AppMutedTextBrush}" FontFamily="Menlo, Consolas, monospace" />
                                            <TextBlock Grid.Column="1" Text="{Binding Key}" Foreground="#7FB0DE" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Raw command -->
        <Border Grid.Row="2" Background="{DynamicResource AppInsetBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="CLI" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                    <TextBox Text="{Binding CommandText}" Width="360" Watermark="e.g. INCR counter"
                             FontFamily="Menlo, Consolas, monospace" />
                    <Button Content="Run" Command="{Binding RunCommandCommand}" />
                </StackPanel>
                <TextBox Text="{Binding CommandResult}" IsReadOnly="True" MaxHeight="80"
                         Background="#0E0E0E" Foreground="#9FD3A0" BorderThickness="0"
                         FontFamily="Menlo, Consolas, monospace"
                         TextWrapping="NoWrap"
                         IsVisible="{Binding CommandResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding StatusText}" Foreground="#9FD3A0" />
        </Border>
    </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteStuff.ViewModels"
        xmlns:controls="using:RemoteStuff.Views.Controls"
        x:Class="RemoteStuff.Views.DeveloperWindow"
        x:DataType="vm:DeveloperViewModel"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBrush}"
        Title="Developer Tools">

    <DockPanel Margin="0">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:LineIcon Kind="settings" Width="16" Height="16" VerticalAlignment="Center"
                           Foreground="#EEE" />
                <TextBlock Text="Diagnostics" FontWeight="Bold" FontSize="14"
                           Foreground="#EEE" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <controls:LineIcon Kind="refresh-cw" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <controls:LineIcon Kind="clipboard" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Copy" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <CheckBox Content="Auto-refresh" IsChecked="{Binding AutoRefresh}"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Report -->
        <ScrollViewer>
            <TextBox Text="{Binding Report}" IsReadOnly="True"
                     FontFamily="Menlo,Consolas,monospace" FontSize="12"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     Background="Transparent" BorderThickness="0"
                     Padding="14" />
        </ScrollViewer>
    </DockPanel>
</Window>

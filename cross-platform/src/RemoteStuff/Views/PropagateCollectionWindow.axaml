<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteStuff.ViewModels"
        x:Class="RemoteStuff.Views.PropagateCollectionWindow"
        x:DataType="vm:PropagateCollectionViewModel"
        Width="540" Height="560"
        MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBrush}"
        Title="Copy Lists Between Profiles">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🗂" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="Copy Lists Between Profiles" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}"
                           Text="Pick a list and a profile to copy it from, then push it onto the ticked profiles." />
            </StackPanel>
        </Border>

        <!-- Footer actions -->
        <Border DockPanel.Dock="Bottom" Padding="14,10"
                Background="{DynamicResource AppChromeBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding CopyDescription}" FontSize="11"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource AppAccentBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Done" Command="{Binding DoneCommand}" />
                    <Button Content="Copy to ticked profiles" Classes="accent"
                            Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Padding="14,12">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="56,*" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="List" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="240"
                              ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="56,*" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="280"
                              ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Preview -->
                <Border Grid.Row="2" Margin="0,0,0,10" Padding="1"
                        Background="{DynamicResource AppInsetBrush}"
                        BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PreviewItems}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" ColumnDefinitions="56,*">
                    <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200"
                              ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
